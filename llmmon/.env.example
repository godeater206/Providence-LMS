# llmmon configuration — copy to .env (same directory as docker-compose.yml), edit, then:
#   docker compose up -d --build
# The installer generates this file for you; only touch it when you want different values.

# --- paths (absolute; must exist) -------------------------------------------------------
# Directory holding server.py / Dockerfile — i.e. the llmmon/ folder of this repo checkout.
LLMON_DIR=/home/you/Providence-LMS/llmmon
# LM Studio home of the user that owns the daemon (usually ~/.lmstudio).
LMS_HOME=/home/you/.lmstudio

# --- dashboard -------------------------------------------------------------------------
LLMON_HOSTNAME=my-llm-server          # shown in the header; blank = machine hostname
LLMON_PORT=8899                       # bound on 0.0.0.0 (host network) — no auth, LAN only

# Reboot button: SSH target + key used to run /usr/local/bin/reboot_server.sh with sudo.
# Leave LLMON_REBOOT_SSH blank to disable the reboot button entirely.
LLMON_REBOOT_SSH=you@192.168.1.50

# CPU package power source (mounted read-only at /rapl). Intel: intel-rapl/intel-rapl:0/...
# AMD EPYC/Threadripper often exposes amd-rapl instead; the installer autodetects.
LLMON_RAPL_FILE=/rapl/intel-rapl/intel-rapl:0/energy_uj

# --- the two load buttons ---------------------------------------------------------------
# Keys must match what `lms ls` prints (publisher/model identifier). Download models with
#   lms get <publisher>/<model>
# Blank value = keep the default baked into server.py. Button labels follow the identifiers.
LLMON_MODEL_A_KEY=qwen3.8-27b-turbo-fable-cold-fusion-735-882-heretic-uncensored-neo-coder-max-mtp
LLMON_MODEL_A_ID=Uncensored-262K
LLMON_MODEL_A_CTX=262144

# Button B unloads everything first (unconditional), for models that need all the VRAM.
LLMON_MODEL_B_KEY=qwen3.8-flash-next-gsq-rco-abliterated
LLMON_MODEL_B_ID=Qwen-Abliterated
LLMON_MODEL_B_CTX=262144
